.DS_Store
.env
.scratch/
__pycache__/
*.pyc
.venv/
staticfiles/

# Built by bin/tailwind, never committed
.bin/
static/css/

# Terraform: providers, state (kept in a bucket), and the billing account ID
.terraform/
*.tfstate*
terraform.tfvars

# Terraform: anything that can hold values or credentials
*.tfvars
*.tfvars.json
*.tfplan
*.plan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Google Cloud credentials, should one ever land in the repo
*-key.json
*credentials*.json
service-account*.json